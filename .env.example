# Copie para .env e ajuste.  (cp .env.example .env  |  Windows: copy .env.example .env)

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Banco: escolha UMA opção ----
# A) PostgreSQL local via docker compose (porta 5433 para não conflitar com um Postgres instalado)
DATABASE_URL=postgres://conectaverde:conectaverde@127.0.0.1:5433/conectaverde
# B) Cloud SQL via Cloud SQL Auth Proxy rodando na sua máquina (porta 5432)
# DATABASE_URL=postgres://conectaverde_app:SENHA@127.0.0.1:5432/conectaverde

# JWT (em produção use um valor diferente do DJANGO_SECRET_KEY, com 32+ caracteres)
JWT_SIGNING_KEY=troque-por-outra-chave-longa-e-aleatoria-32+
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Front-end Next.js
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOWED_ORIGIN_REGEXES=^https://conectaverde-.*\.vercel\.app$

# Senha dos 4 usuários demo (python manage.py seed_demo)
DEMO_USERS_PASSWORD=ConectaVerde@2026
